    {
      "name": "01. 认证模块 - 正常场景",
      "item": [
        {
          "name": "01.01 - 用户登录成功",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{userUsername}}\",\"password\":\"{{userPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回码应为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('应返回 token', function () { pm.expect(json.data.token).to.be.a('string'); });",
                  "pm.test('角色应为 USER', function () { pm.expect(json.data.roleKey).to.eql('USER'); });",
                  "pm.environment.set('userToken', json.data.token);",
                  "pm.environment.set('userId', json.data.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "01.02 - 管理员登录成功",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回码应为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('应返回 token', function () { pm.expect(json.data.token).to.be.a('string'); });",
                  "pm.test('角色应为 ADMIN', function () { pm.expect(json.data.roleKey).to.eql('ADMIN'); });",
                  "pm.environment.set('adminToken', json.data.token);",
                  "pm.environment.set('adminId', json.data.userId);"
                ]
              }
            }
          ]
        }
      ]
    },
