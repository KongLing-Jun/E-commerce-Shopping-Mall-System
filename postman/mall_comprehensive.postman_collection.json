        {
          "name": "11.02 - 验证订单最终状态",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回码应为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "const records = (json.data && json.data.content) || [];",
                  "const orderNo = pm.environment.get('orderNo');",
                  "const current = records.find(x => x.orderNo === orderNo);",
                  "pm.test('当前订单应存在', function () { pm.expect(current).to.exist; });",
                  "if (current) {",
                  "  pm.test('订单状态应为已完成', function () { pm.expect(current.status).to.eql(3); });",
                  "  pm.test('快递单号应正确', function () { pm.expect(current.expressNo).to.eql('SF123456789CN'); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
