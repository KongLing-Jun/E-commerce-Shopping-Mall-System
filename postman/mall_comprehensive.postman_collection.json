    {
      "name": "04. 商品模块 - 正常场景",
      "item": [
        {
          "name": "04.01 - 获取首页推荐商品",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/home/recommend"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回码应为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "const products = (json.data && (json.data.products || json.data.recommendProducts)) || [];",
                  "pm.test('推荐商品不应为空', function () { pm.expect(products.length).to.be.greaterThan(0); });",
                  "pm.environment.set('productId', products[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "04.02 - 获取商品详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回码应为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('商品图片应为数组', function () { pm.expect(Array.isArray(json.data.images)).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04.03 - 获取商品列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/products?page=0&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码应为 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回码应为 200', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('商品列表应为数组', function () { pm.expect(Array.isArray(json.data.content)).to.eql(true); });"
                ]
